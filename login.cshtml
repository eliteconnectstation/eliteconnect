@{
    ViewData["Title"] = "Login";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container d-flex justify-content-center align-items-center vh-100">

    <div class="card shadow-lg p-4" style="width: 400px; border-radius: 20px;">

        <h3 class="text-center mb-3">Insurance Platform</h3>
        <p class="text-center text-muted">Select your role</p>

        <form method="post">

            <button name="role" value="Admin" class="btn btn-primary w-100 mb-3">
                🔐 Login as Admin
            </button>

            <button name="role" value="Agent" class="btn btn-success w-100 mb-3">
                📞 Login as Agent
            </button>

            <button name="role" value="Client" class="btn btn-warning w-100">
                👤 Login as Client
            </button>

        </form>

    </div>

</div>