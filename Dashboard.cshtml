@{
    ViewData["Title"] = "Dashboard";
    string role = ViewBag.Role;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="d-flex">

    <!-- Sidebar -->
    <div class="bg-dark text-white p-4 vh-100" style="width: 250px;">
        <h4 class="mb-4">Insurance System</h4>

        <a class="d-block text-white mb-3 text-decoration-none">Dashboard</a>
        <a class="d-block text-white mb-3 text-decoration-none">Leads</a>
        <a class="d-block text-white mb-3 text-decoration-none">Call Logs</a>

        @if (role == "Admin")
        {
            <a class="d-block text-white mb-3 text-decoration-none">Users</a>
            <a class="d-block text-white mb-3 text-decoration-none">Agencies</a>
            <a class="d-block text-white mb-3 text-decoration-none">Reports</a>
        }

        @if (role == "Client")
        {
            <a class="d-block text-white mb-3 text-decoration-none">Qualified Leads</a>
        }

        <a href="/Home/Login" class="d-block text-danger mt-5 text-decoration-none">Logout</a>
    </div>

    <!-- Main Content -->
    <div class="p-4 w-100 bg-light">
        <h2>@role Dashboard</h2>
        <p class="text-muted">Welcome to your system</p>

        <div class="row mt-4">

            <div class="col-md-3">
                <div class="card shadow-sm p-3">
                    <h6>Total Leads</h6>
                    <h2>120</h2>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm p-3">
                    <h6>Qualified Leads</h6>
                    <h2>30</h2>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm p-3">
                    <h6>Calls</h6>
                    <h2>85</h2>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm p-3">
                    <h6>Agencies</h6>
                    <h2>10</h2>
                </div>
            </div>

        </div>

        <div class="card shadow-sm mt-4 p-3">
            <h5>Recent Leads</h5>

            <table class="table mt-3">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Ahmad</td>
                        <td>0790000000</td>
                        <td><span class="badge bg-primary">New</span></td>
                    </tr>

                    <tr>
                        <td>Sara</td>
                        <td>0780000000</td>
                        <td><span class="badge bg-success">Qualified</span></td>
                    </tr>

                    <tr>
                        <td>Omar</td>
                        <td>0770000000</td>
                        <td><span class="badge bg-warning text-dark">Callback</span></td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>

</div>